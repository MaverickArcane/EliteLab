# Copy to .env and point at your Elite Dangerous journal folder.
# Windows (Docker Desktop):
ELITELAB_JOURNAL_DIR=C:/Users/YOU/Saved Games/Frontier Developments/Elite Dangerous
# Linux / Steam Proton example:
# ELITELAB_JOURNAL_DIR=/home/you/.steam/steam/steamapps/compatdata/359320/pfx/drive_c/users/steamuser/Saved Games/Frontier Developments/Elite Dangerous
